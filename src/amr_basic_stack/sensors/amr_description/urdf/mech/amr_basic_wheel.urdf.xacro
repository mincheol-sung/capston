<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="amr_wheel_radius" value="0.04" />
  <xacro:property name="amr_wheel_width"  value="0.0448" />
  <xacro:property name="amr_wheel_mass"   value="0.5" />
  <!-- Joint positions relative to base_link (axle height), symmetrized from
       the amr_basic.urdf source values (+-0.09491, +-0.10352). -->
  <xacro:property name="amr_wheel_xoff"   value="0.09491" />
  <xacro:property name="amr_wheel_yoff"   value="0.10352" />

  <!-- Mecanum wheel via anisotropic friction (official Gazebo approach, PR
       gazebosim/gz-sim#683). Requires the DART (dartsim) physics engine.
       A sphere collision carries a single ground contact; the directional
       friction expressed in the chassis frame does the mecanum work:
         mu  (along fdir1, the 45-deg roller axle) = grip
         mu2 (perpendicular, the rolling direction) = 0 -> free roll
       fdir1 = (1, -roller_dir, 0) sets the \ vs / chirality per wheel.
       fdir1 gz:expressed_in must reference base_footprint (root link): DART
       lumps fixed-joint links, so base_link is not a body node there.

       Only two wheel meshes exist (front_left / front_right, CAD assembly
       coordinates, mm). Rear wheels reuse the opposite chirality by rotating
       the same mesh 180 deg about z; visual_xyz/visual_rpy per instance
       recenter the mesh onto the wheel link origin. -->
  <xacro:macro name="amr_basic_wheel" params="prefix side x_reflect y_reflect roller_dir mesh_file visual_xyz visual_rpy">

    <link name="${prefix}${side}_wheel_link">
      <visual>
        <origin xyz="${visual_xyz}" rpy="${visual_rpy}"/>
        <geometry>
          <mesh filename="package://amr_description/meshes/amr_basic/visual/${mesh_file}"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${amr_wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${amr_wheel_mass}"/>
        <inertia
          ixx="${(amr_wheel_mass/12.0)*(3*amr_wheel_radius*amr_wheel_radius + amr_wheel_width*amr_wheel_width)}" ixy="0" ixz="0"
          iyy="${(amr_wheel_mass/2.0)*(amr_wheel_radius*amr_wheel_radius)}" iyz="0"
          izz="${(amr_wheel_mass/12.0)*(3*amr_wheel_radius*amr_wheel_radius + amr_wheel_width*amr_wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${prefix}${side}_wheel_joint" type="continuous">
      <axis xyz="0 1 0"/>
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}${side}_wheel_link"/>
      <origin xyz="${x_reflect*amr_wheel_xoff} ${y_reflect*amr_wheel_yoff} 0"
              rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}${side}_wheel_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="${prefix}base_footprint">1 ${-roller_dir} 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual>
        <material>
          <ambient>0.05 0.05 0.05 1.0</ambient>
          <diffuse>0.05 0.05 0.05 1.0</diffuse>
          <specular>0.05 0.05 0.05 1.0</specular>
          <emissive>0.0 0.0 0.0 0.0</emissive>
        </material>
      </visual>
    </gazebo>

  </xacro:macro>
</robot>
