<?xml version="1.0"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration package for the AMR basic stack.</description>
  <maintainer email="amr@example.com">AMR Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_base</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_laser_tools</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
