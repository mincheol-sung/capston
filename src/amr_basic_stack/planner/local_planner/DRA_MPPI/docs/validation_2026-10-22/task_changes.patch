+        if pending:
+            for future in pending:
+                future.cancel()
+            wait(futures)
+            raise TimeoutError('guide worker deadline exceeded; workers drained')
+        # All tasks have finished even if an individual future raises.
+        return [future.result() for future in futures]
 
