Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 720
- Class: rviz_common/Views
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Tool Properties
  Name: Tool Properties
  Splitter Ratio: 0.6
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 15
    Frames:
      All Enabled: false
    Marker Scale: 0.4
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree: {}
    Update Interval: 0
    Value: false
  - Alpha: 0.9
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Name: RobotModel
    Value: true
    Visual Enabled: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Map (map_server)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Alpha: 0.6
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Traversable Map (계획 미반영)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /traversable_map_grid
    Update Topic:
      Value: /traversable_map_grid_updates
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Color: 255; 255; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: MergedScan
    Position Transformer: XYZ
    Size (Pixels): 3
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Octomap Voxels (z 색)
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /occupied_cells_vis_array
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Enabled: true
    Name: Cloud z-band [0.033, 0.31]
    Alpha: 1.0
    Size (m): 0.03
    Style: Boxes
    Color Transformer: FlatColor
    Color: 0; 255; 0
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /traversability/cloud_band
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Enabled: false
    Name: Cloud filtered (전체 높이)
    Alpha: 1.0
    Size (m): 0.02
    Style: Points
    Color Transformer: AxisColor
    Axis: Z
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /traversability/cloud_filtered
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 255; 0
    Enabled: true
    Head Diameter: 0.0
    Head Length: 0.0
    Line Style: Lines
    Line Width: 0.05
    Name: Global Path (Theta*)
    Offset:
      X: 0
      Y: 0
      Z: 0.01
    Pose Style: None
    Shaft Diameter: 0.0
    Shaft Length: 0.0
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_path
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: false
    Name: Global Waypoints
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_path_waypoints
    Value: false
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 170; 255
    Enabled: true
    Head Diameter: 0.0
    Head Length: 0.0
    Line Style: Lines
    Line Width: 0.04
    Name: MPPI Selected Path
    Offset:
      X: 0
      Y: 0
      Z: 0.02
    Pose Style: None
    Shaft Diameter: 0.0
    Shaft Length: 0.0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /dra_mppi/selected_path
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: MPPI Rollouts
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /dra_mppi/rollouts
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: DRA Person Predictions (CV blue / CT orange)
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /prediction_markers
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 85; 255
    Enabled: true
    Head Diameter: 0.0
    Head Length: 0.0
    Line Style: Lines
    Line Width: 0.02
    Name: MPC Reference Horizon
    Offset:
      X: 0
      Y: 0
      Z: 0.03
    Pose Style: None
    Shaft Diameter: 0.0
    Shaft Length: 0.0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /mpc/reference_horizon
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: false
    Name: Detections
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /detection_markers
    Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 60
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  Tool Properties:
    collapsed: false
  Width: 1600
  X: 50
  Y: 30
