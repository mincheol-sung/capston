<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>traversability</name>
  <version>0.0.0</version>
  <description>기준 2D 맵과 관측을 합쳐 3-state traversable map 을 Planning 에 제공한다.</description>
  <maintainer email="yumin@todo.todo">yumin</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs_py</depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>octomap_rviz_plugins</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>
  <depend>amr_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
