<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_slam</name>
  <version>0.0.0</version>
  <description>Persistent object mapping and AMR object-goal navigation</description>
  <maintainer email="yumin@todo.todo">yumin</maintainer>
  <license>TODO: License declaration</license>

  <build_depend>python3-dev</build_depend>
  <build_depend>build-essential</build_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>amr_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>cartographer_ros_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_ros_pipeline.py runs the real detector, Theta* and traversability nodes. -->
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>global_planner</test_depend>
  <test_depend>python3-pil</test_depend>
  <test_depend>sensor_fusion</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>traversability</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
