<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_mpc</name>
  <version>0.1.0</version>
  <description>WP4 trajectory-tracking MPC (Wang Ch.1-2 form) for the mecanum AMR. Follows /dra_mppi/reference_trajectory and owns /cmd_vel.</description>
  <maintainer email="hw030918@pusan.ac.kr">smoc</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>amr_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>   <!-- state_estimator_node, 시뮬 센서 -->
  <depend>tf2_ros</depend>   <!-- sim_plant_torque_node 의 map → base_footprint TF -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>   <!-- config/plant.yaml 적재 (params.py) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
